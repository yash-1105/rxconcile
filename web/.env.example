# Web configuration. Copy to .env.local and fill in. .env.local is gitignored.

# Where the API lives. REQUIRED for a production build -- `vite build` refuses
# to run without it, because a bundle that falls back to same-origin deploys
# successfully and then 404s on every request.
#
# Leave it UNSET for local development: `npm run dev` proxies /api to the local
# API (see vite.config.ts), so same-origin is correct there.
VITE_API_URL=https://your-api.up.railway.app
