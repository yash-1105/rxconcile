# rxconcile configuration
# Copy to .env and fill in real values. .env is gitignored.

GCP_PROJECT_ID=your-project-id
GCP_LOCATION=global

# Model IDs. Verify against the live API before changing:
#   scripts/list_models.sh
GEMINI_MODEL=gemini-3.7-flash

# Pro-tier escalation for hard documents. Not used for quota retries.
GEMINI_MODEL_FALLBACK=gemini-3.1-pro-preview

# Used only when GEMINI_MODEL is quota-exhausted (429). Must be same-tier, so a
# quota retry is not a capability downgrade. REQUIRED: no model ID is hardcoded
# in Python, so every runtime model must be set here.
GEMINI_MODEL_QUOTA_FALLBACK=gemini-3.6-flash

# Extraction runs per document. Per-field agreement across these runs is the
# reliability signal (the model's own confidence score was measured to carry no
# information). Set to 1 for cheap iteration; agreement is then reported as null.
EXTRACTION_RUNS=3

MAX_UPLOAD_MB=15

# ---------------------------------------------------------------------------
# Deployment. Every one of these has a working local default, so leave them
# unset for local work and set them in the deployed environment.
# ---------------------------------------------------------------------------

# The service account key JSON, whole and unmodified, as a single value. Parsed
# in memory and never written to disk -- a key FILE is forbidden (CLAUDE.md
# rule 9), which is also why GOOGLE_APPLICATION_CREDENTIALS is rejected on
# sight: that one names a path.
#
# Leave UNSET locally: without it, Application Default Credentials are used.
#   gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account", ...}

# Where the SQLite file lives. Unset means the local default, api/data. A
# deployment must set this to a mounted volume -- the default is derived from
# the installed package location, which is meaningless in a container.
# DATABASE_PATH=/data/rxconcile.db

# Browser origins allowed to call this API, comma-separated. Defaults to the
# Vite dev server.
# ALLOWED_ORIGINS=https://rxconcile.vercel.app

# The port to bind. Set by the platform; the start command falls back to 8000.
# PORT=8000
